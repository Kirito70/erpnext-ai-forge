{
  "_comment": "Hooks and permissions below are generated by erpnext-ai-forge 0.1.0 for target 'self'. Edit canonical/harness/, then run `forge sync`. Other keys in this file are yours and are preserved on merge.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/harness/hook-posttooluse.sh\"",
            "timeout": 240,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/harness/hook-stop.sh\"",
            "timeout": 420,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run --project forge*)",
      "Bash(uv sync*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(grep*)",
      "Bash(find*)",
      "Bash(ls*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(bench --site * reinstall*)",
      "Bash(bench drop-site*)",
      "Bash(forge sync*)"
    ]
  }
}
