{#-
  The forge-owned fragment of .claude/settings.json.

  This is NOT the whole file. It is merged into whatever is already there
  (settings_merge.deep_merge, with a .forge-backup taken first), because
  settings.json is human-owned: it carries permissions and hooks forge did not
  write and must not remove.
-#}
{
  "_comment": "Hooks and permissions below are generated by erpnext-ai-forge {{ forge.version }} for target '{{ target.name }}'. Edit canonical/harness/, then run `forge sync`. Other keys in this file are yours and are preserved on merge.",
  "permissions": {
    "allow": [
{%- for entry in profile_permissions.allow | default([]) %}
      {{ entry | tojson }}{% if not loop.last %},{% endif %}
{%- endfor %}
    ],
    "deny": [
{%- for entry in permissions.deny_all | default([]) %}
      {{ entry | tojson }}{% if not loop.last %},{% endif %}
{%- endfor %}
    ]
  },
  "hooks": {
{%- set grouped = {} %}
{%- for hook in hooks %}
{%- set native = events[hook.fires_on].native %}
{%- if grouped.update({native: (grouped.get(native, []) + [hook])}) %}{% endif %}
{%- endfor %}
{%- for native, items in grouped.items() %}
    {{ native | tojson }}: [
      {
        "matcher": {{ events[items[0].fires_on].matcher | tojson }},
        "hooks": [
{%- for hook in items %}
          {
            "type": "command",
            "command": {{ ('bash "$CLAUDE_PROJECT_DIR/' ~ scripts_dir ~ '/' ~ harness.script(hook.script).filename ~ '"' ~ (' ' ~ hook.args | join(' ') if hook.args else '')) | tojson }},
            "timeout": {{ hook.timeout_seconds }}
          }{% if not loop.last %},{% endif %}
{%- endfor %}
        ]
      }
    ]{% if not loop.last %},{% endif %}
{%- endfor %}
  }
}
