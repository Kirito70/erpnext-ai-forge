{#-
  Antigravity native hooks. Stop only — see capabilities.hook_events in
  adapter.yaml for why there is no per-file hook here.
-#}
{
  "_comment": "Generated by erpnext-ai-forge {{ forge.version }} for target '{{ target.name }}'. Edit canonical/harness/, then run `forge sync`.",
  "hooks": [
{%- for hook in hooks %}
    {
      "event": {{ events[hook.fires_on].native | tojson }},
      "command": {{ ("bash " ~ scripts_dir ~ "/" ~ harness.script(hook.script).filename) | tojson }},
      "timeout": {{ hook.timeout_seconds }}
    }{% if not loop.last %},{% endif %}
{%- endfor %}
  ]
}
